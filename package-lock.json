{
  "name": "siberslice",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "siberslice",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@siberslice/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@siberslice/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/core": {
      "name": "@siberslice/core",
      "version": "0.1.0"
    },
    "packages/web": {
      "name": "@siberslice/web",
      "version": "0.1.0",
      "dependencies": {
        "@siberslice/core": "0.1.0"
      }
    }
  }
}
